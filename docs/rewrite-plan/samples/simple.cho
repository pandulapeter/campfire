{title: Campfire Song}
{artist: The Sample Band}
{key: E}
{capo: 0}

{start_of_verse: Verse 1}
[E]Sitting by the [A]fire tonight
[E]Watching all the [B7]stars so bright
[E]Everybody [A]sing along
[E]This is our [B7]campfire [E]song
{end_of_verse}

{start_of_chorus}
[A]Oh, the [E]night is young
[A]And the [B7]song's not [E]done
{end_of_chorus}

{start_of_verse: Verse 2}
[E]Pass the guitar [A]round the ring
[E]Everyone knows [B7]how to sing
[E]Strum the chords and [A]hum the tune
[E]Underneath the [B7]summer [E]moon
{end_of_verse}

{chorus}
