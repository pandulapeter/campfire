<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Campfire</string>
	<!-- The extension's strings are its own Localizable.strings, in the system's language. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>hu</string>
		<string>ro</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>it</string>
		<string>he</string>
		<string>pt</string>
		<string>pl</string>
		<string>cs</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- Written during the build by the same script as the app's: App Store Connect refuses an extension whose
	     version differs from its app's. -->
	<key>CFBundleShortVersionString</key>
	<string>0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<!-- Where the inbox is, the app's Info.plist naming the same group. -->
	<key>CampfireAppGroup</key>
	<string>$(APP_GROUP_ID)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- Run by Safari in the page shared, so its text arrives as the reader sees it (PageText.js). -->
			<key>NSExtensionJavaScriptPreprocessingFile</key>
			<string>PageText</string>
			<!--
			     Selected text, a web page, and the files the import reads. A predicate rather than the dictionary form,
			     whose file key takes any file at all. Plain text covers .txt, the ChordPro family, and ABC tunes, whose
			     types (declared by the app) conform to it. A web page is offered as a URL that is no file's: Safari
			     then hands the extension the property list PageText.js answers instead (its own text, title, and
			     address), so the rule names no property list, which would offer Campfire for every .plist file; any
			     other browser, or any app sharing a link, hands over the URL itself, which the app reads once by
			     itself (a Campfire share link is opened as one).
			     JSON conforms to public.text but not to public.plain-text, so it is named for the songs another
			     app's export holds. Keep in step with LibraryFiles.IMPORTABLE_EXTENSIONS, as the app's document
			     types are with SONG_EXTENSIONS: the legacy .doc (which the import only reports as unreadable) is
			     left out on purpose, and OnSong's .onsong has no system type to name (the app declares OpenSong's
			     backups as zip archives, its .osts sets as plain text, and JustChords' .justchords as JSON, as it
			     does SongbookPro's backups). A photo
			     is a new song showing it: a PNG, JPEG, GIF, or WebP, shrunk where it is too large for a song, or a
			     HEIC or HEIF one (what Photos shares of a camera's photo), converted.
			-->
			<key>NSExtensionActivationRule</key>
			<string>SUBQUERY (
    extensionItems,
    $extensionItem,
    SUBQUERY (
        $extensionItem.attachments,
        $attachment,
        ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "public.plain-text"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "public.json"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "com.adobe.pdf"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "org.openxmlformats.wordprocessingml.document"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "public.zip-archive"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "com.pandulapeter.campfire.songbookpro-backup"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "public.png"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "public.jpeg"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "com.compuserve.gif"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "org.webmproject.webp"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "public.heic"
        || ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO "public.heif"
        || SUBQUERY (
            $attachment.registeredTypeIdentifiers,
            $type,
            $type UTI-CONFORMS-TO "public.url" AND NOT ($type UTI-CONFORMS-TO "public.file-url")
        ).@count &gt;= 1
    ).@count &gt;= 1
).@count &gt;= 1</string>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
	</dict>
</dict>
</plist>
