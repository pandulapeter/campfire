<resources>

    <!-- The tone the Material 3 light scheme takes its primary color from, so the icon is the color of the theme. -->
    <color name="campfire_system">@android:color/system_accent1_600</color>

    <!-- The widgets' gallery previews in the wallpaper's colors, which Glance draws the widgets in from Android 12 on. -->
    <color name="campfire_widget_background">@android:color/system_accent2_50</color>
    <color name="campfire_widget_primary">@android:color/system_accent1_600</color>
    <color name="campfire_widget_placeholder">@android:color/system_neutral2_700</color>

</resources>
