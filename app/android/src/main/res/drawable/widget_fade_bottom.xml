<!--
  The setlist widget's list fading out at the bottom: opaque at the edge, clear towards the list. White, tinted with the widget's background
  (SetlistWidgetLayout), since only the alpha is meant.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#00FFFFFF"
        android:startColor="#FFFFFFFF" />
</shape>
