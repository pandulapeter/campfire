<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The one thing Campfire ever reaches the network for: the cloud folder the user connected in Settings. Nothing
      else in the app talks to anything, and sync is off until the user turns it on.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      A sync run has to survive the user leaving the app, which on Android means a foreground service, which in
      turn means a notification. The notification permission is only ever asked for when sync is switched on; a
      refusal costs the notification, not the sync.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The library is the only copy of the user's own work, so it is in the device's backup and in a transfer to a
      new phone, together with the settings: see the two rules files, one per generation of Android. That copy is
      made by the system, to wherever the user's device backs up to - the app's own process still makes no request
      for it. What connects the app to a cloud folder is deliberately not on the list.
    -->
    <application
        android:name=".CampfireAndroidApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/campfire"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Campfire"
        tools:ignore="UnusedAttribute"
        tools:targetApi="s">

        <activity
            android:name=".CampfireActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opening a ChordPro file with Campfire. The pattern has to carry a MIME type to match a content URI at
              all, and there is no registered type for these extensions, so the type is the wildcard and the
              extension is what actually decides. This filter lists only the ChordPro family; the MIME fallback
              below covers providers whose URI does not carry the file name.
              Only content URIs are claimed: the app holds no storage permission, so a file URI outside its own
              directories cannot be read, and a file manager would offer Campfire for an open that fails.
            -->
            <intent-filter android:label="@string/campfire">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <!-- Android 12 and later: an exact suffix, whatever the rest of the path holds. The matcher is
                     case-sensitive, so the capitalized spellings a FAT card or a Windows machine produces are listed
                     too. pathAdvancedPattern is no help here: it never backtracks, so ".*\\.cho" in it matches nothing. -->
                <data android:pathSuffix=".cho" />
                <data android:pathSuffix=".chopro" />
                <data android:pathSuffix=".chordpro" />
                <data android:pathSuffix=".crd" />
                <data android:pathSuffix=".chord" />
                <data android:pathSuffix=".pro" />
                <data android:pathSuffix=".CHO" />
                <data android:pathSuffix=".CHOPRO" />
                <data android:pathSuffix=".CHORDPRO" />
                <data android:pathSuffix=".CRD" />
                <data android:pathSuffix=".CHORD" />
                <data android:pathSuffix=".PRO" />
                <!-- Android 9 to 11 have only pathPattern, whose ".*" stops at the first occurrence of the character
                     after it and never backtracks, so a pattern matches a path with exactly as many dots as it has.
                     One pattern per count, up to four dots in the whole path; a path with more is imported from
                     inside the app instead. -->
                <data android:pathPattern=".*\\.cho" />
                <data android:pathPattern=".*\\..*\\.cho" />
                <data android:pathPattern=".*\\..*\\..*\\.cho" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.cho" />
                <data android:pathPattern=".*\\.chopro" />
                <data android:pathPattern=".*\\..*\\.chopro" />
                <data android:pathPattern=".*\\..*\\..*\\.chopro" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.chopro" />
                <data android:pathPattern=".*\\.chordpro" />
                <data android:pathPattern=".*\\..*\\.chordpro" />
                <data android:pathPattern=".*\\..*\\..*\\.chordpro" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.chordpro" />
                <data android:pathPattern=".*\\.crd" />
                <data android:pathPattern=".*\\..*\\.crd" />
                <data android:pathPattern=".*\\..*\\..*\\.crd" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.crd" />
                <data android:pathPattern=".*\\.chord" />
                <data android:pathPattern=".*\\..*\\.chord" />
                <data android:pathPattern=".*\\..*\\..*\\.chord" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.chord" />
                <data android:pathPattern=".*\\.pro" />
                <data android:pathPattern=".*\\..*\\.pro" />
                <data android:pathPattern=".*\\..*\\..*\\.pro" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.pro" />
            </intent-filter>

            <!--
              Some document providers keep the display name out of the content URI, so none of the suffixes above
              can match even when the file is named .cho. A second View filter accepts the two MIME types such files
              are commonly opened as. It also offers Campfire for other text or generic files; the import reads the
              display name after selection and skips unsupported extensions.
            -->
            <intent-filter android:label="@string/campfire">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!--
              Coming back from the sync service's consent page. The scheme is the one every platform registers,
              see REDIRECT_SCHEME in :data:source:remote:implementation. The activity is singleTask, so this lands
              in onNewIntent of the running app rather than in a second instance - or, when the process was killed
              while the browser was in front, in the onCreate or onNewIntent of a new one, which is what
              AndroidSyncAuthenticator.consumePendingRedirect is for.
            -->
            <intent-filter android:label="@string/campfire">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="campfire" />
            </intent-filter>

            <!--
              Sharing a song or zip archive to Campfire. ChordPro files may be sent as text/plain or, because .cho
              has no registered MIME type, application/octet-stream. Archives are usually application/zip; some
              senders use application/x-zip-compressed. Shared text arrives as EXTRA_TEXT (see importSharedTexts).
              The importer checks the display name and skips unrelated files with these types.
            -->
            <intent-filter android:label="@string/campfire">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>

        </activity>

        <!--
          Keeps the process alive for as long as a sync run lasts, and shows the run. It does no syncing of its own,
          see CampfireSyncService.

          stopWithTask is false, which is also the default, but stated because it is the whole point of the service:
          swiping Campfire away is not a request to abandon a sync half way through a library, so the run and its
          notification carry on without the activity and the notification keeps counting up on its own.
        -->
        <service
            android:name=".sync.CampfireSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Lets a shared song leave the app's private storage as a content URI, see CampfireActivity.shareFile. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
