<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The one thing Campfire ever reaches the network for: the cloud folder the user connected in Settings. Nothing
      else in the app talks to anything, and sync is off until the user turns it on.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      A sync run has to survive the user leaving the app, which on Android means a foreground service, which in
      turn means a notification. The notification permission is only ever asked for when sync is switched on; a
      refusal costs the notification, not the sync.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CampfireAndroidApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/campfire"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Campfire"
        tools:ignore="UnusedAttribute"
        tools:targetApi="s">

        <activity
            android:name=".CampfireActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opening a ChordPro file with Campfire. The pattern has to carry a MIME type to match a content URI at
              all, and there is no registered type for these extensions, so the type is the wildcard and the
              extension is what actually decides. Only the ChordPro family is listed: zip and plain text belong to
              everything, and claiming them would put Campfire in the way of every archive and note on the device.
            -->
            <intent-filter android:label="@string/campfire">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.cho" />
                <data android:pathPattern=".*\\.chopro" />
                <data android:pathPattern=".*\\.chordpro" />
                <data android:pathPattern=".*\\.crd" />
                <data android:pathPattern=".*\\.chord" />
                <data android:pathPattern=".*\\.pro" />
            </intent-filter>

            <!--
              Coming back from the sync service's consent page. The scheme is the one every platform registers,
              see REDIRECT_SCHEME in :data:source:remote:implementation. The activity is singleTask, so this lands
              in onNewIntent of the running app rather than in a second instance.
            -->
            <intent-filter android:label="@string/campfire">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="campfire" />
            </intent-filter>

            <!--
              Sharing a song to Campfire. Narrowed to text, for the same reason: a filter on every type would put
              Campfire in the share sheet of every photo and video on the device.
            -->
            <intent-filter android:label="@string/campfire">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <!--
          Keeps the process alive for as long as a sync run lasts, and shows the run. It does no syncing of its own,
          see CampfireSyncService.

          stopWithTask is false, which is also the default, but stated because it is the whole point of the service:
          swiping Campfire away is not a request to abandon a sync half way through a library, so the run and its
          notification carry on without the activity and the notification keeps counting up on its own.
        -->
        <service
            android:name=".sync.CampfireSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Lets a shared song leave the app's private storage as a content URI, see CampfireActivity.shareFile. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
