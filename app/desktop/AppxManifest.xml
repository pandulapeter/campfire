<!--
 The manifest of the Microsoft Store package, which `packageReleaseMsix` fills in and packs around the release app image.
 The @…@ tokens are replaced by that task: the identity and the two names from the campfire.windows.* properties -
 which have to repeat Partner Center's Product identity page to the letter - and the version from campfire.versionName.
 The package's DisplayName is the name reserved on the Store; the one under the icon is VisualElements' own.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

    <Identity
        Name="@IDENTITY_NAME@"
        Publisher="@PUBLISHER@"
        Version="@VERSION@"
        ProcessorArchitecture="x64" />

    <Properties>
        <DisplayName>@DISPLAY_NAME@</DisplayName>
        <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
        <Logo>assets\StoreLogo.png</Logo>
    </Properties>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    </Dependencies>

    <!-- Partner Center asks for a store listing in every language the package declares, and every listing is English. -->
    <Resources>
        <Resource Language="en-us" />
    </Resources>

    <Applications>
        <Application Id="Campfire" Executable="Campfire.exe" EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements
                DisplayName="Campfire"
                Description="Your songbook, on every screen you own"
                BackgroundColor="transparent"
                Square150x150Logo="assets\Square150x150Logo.png"
                Square44x44Logo="assets\Square44x44Logo.png" />
            <Extensions>
                <!-- The extensions the .msi claims (chordProFileAssociations() in build.gradle.kts), for the same reason. -->
                <uap:Extension Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="chordpro">
                        <uap:DisplayName>ChordPro song</uap:DisplayName>
                        <uap:SupportedFileTypes>
                            <uap:FileType ContentType="text/plain">.cho</uap:FileType>
                            <uap:FileType ContentType="text/plain">.chopro</uap:FileType>
                            <uap:FileType ContentType="text/plain">.chordpro</uap:FileType>
                        </uap:SupportedFileTypes>
                    </uap:FileTypeAssociation>
                </uap:Extension>
            </Extensions>
        </Application>
    </Applications>

    <!--
     Nothing else: the library is kept in the package's own folder (see packageReleaseMsix) rather than in AppData, which
     Windows virtualizes for a packaged app, since the Store turns down the unvirtualizedResources that would stop it.
    -->
    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>
</Package>
