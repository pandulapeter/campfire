<!--
 The manifest of the Microsoft Store package, which `packageReleaseMsix` fills in and packs around the release app image.
 The @…@ tokens are replaced by that task: the identity and the two names from the campfire.windows.* properties -
 which have to repeat Partner Center's Product identity page to the letter - and the version from campfire.versionName.
 The package's DisplayName is the name reserved on the Store; the one under the icon is VisualElements' own.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
    IgnorableNamespaces="uap desktop6 rescap virtualization">

    <Identity
        Name="@IDENTITY_NAME@"
        Publisher="@PUBLISHER@"
        Version="@VERSION@"
        ProcessorArchitecture="x64" />

    <Properties>
        <DisplayName>@DISPLAY_NAME@</DisplayName>
        <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
        <Logo>assets\StoreLogo.png</Logo>
        <!--
         A packaged app's new files under AppData go to a private copy of the folder that only the app can see and that
         is deleted with it. The library is the user's own work, and the "Location" row in Settings, the rescan when
         the window regains focus and the .msi build all expect it in %APPDATA%\Campfire, so that folder is written to
         where it is. Windows 11 honours the one folder named below; Windows 10 only knows the switch for the whole of
         AppData, which is the next best thing for an app that writes nowhere else. Both need unvirtualizedResources.
        -->
        <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
        <virtualization:FileSystemWriteVirtualization>
            <virtualization:ExcludedDirectories>
                <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\Campfire</virtualization:ExcludedDirectory>
            </virtualization:ExcludedDirectories>
        </virtualization:FileSystemWriteVirtualization>
    </Properties>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    </Dependencies>

    <!-- Partner Center asks for a store listing in every language the package declares, and every listing is English. -->
    <Resources>
        <Resource Language="en-us" />
    </Resources>

    <Applications>
        <Application Id="Campfire" Executable="Campfire.exe" EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements
                DisplayName="Campfire"
                Description="Your songbook, on every screen you own"
                BackgroundColor="transparent"
                Square150x150Logo="assets\Square150x150Logo.png"
                Square44x44Logo="assets\Square44x44Logo.png" />
            <Extensions>
                <!-- The extensions the .msi claims (chordProFileAssociations() in build.gradle.kts), for the same reason. -->
                <uap:Extension Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="chordpro">
                        <uap:DisplayName>ChordPro song</uap:DisplayName>
                        <uap:SupportedFileTypes>
                            <uap:FileType ContentType="text/plain">.cho</uap:FileType>
                            <uap:FileType ContentType="text/plain">.chopro</uap:FileType>
                            <uap:FileType ContentType="text/plain">.chordpro</uap:FileType>
                        </uap:SupportedFileTypes>
                    </uap:FileTypeAssociation>
                </uap:Extension>
            </Extensions>
        </Application>
    </Applications>

    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
        <rescap:Capability Name="unvirtualizedResources" />
    </Capabilities>
</Package>
