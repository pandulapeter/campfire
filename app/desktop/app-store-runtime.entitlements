<!--
 The entitlements of everything in the bundled Java runtime in the Mac App Store build. The JVM itself runs inside
 the app's executable and under its entitlements (app-store.entitlements); the one program of the runtime's own that
 can be started is jspawnhelper, which is how the JDK starts a process. The store wants every executable sandboxed,
 and a program the sandboxed app starts has to inherit its sandbox, with no other entitlement next to these two, or
 it is killed as it starts.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
