# The pre-commit hook's checks, run before `git commit` rather than inside it: git holds the index lock while the hook
# runs, and a build in there kept every other commit of the checkout waiting. Stage the change, run this, then commit
# without naming paths (a commit naming them builds an index of its own, whose tree this did not check, and the hook then
# builds it). It records the staged tree it checked, which the hook then accepts; Gradle waits for a slot shared by every
# worktree (lib.sh).
set -e
cd "$(git rev-parse --show-toplevel)"
. "$(dirname "$0")/lib.sh"
# --branch checks the commit checked out instead, for commits made with CAMPFIRE_DEFER_GRADLE=1 (pre-commit): run once
# on the last of them, with nothing staged or changed beside it, before they land.
if [ "${1:-}" = --branch ]; then
    if ! git diff --quiet HEAD -- . ':(exclude)*.md' ||
        [ -n "$(git ls-files --others --exclude-standard | grep -vE '\.md$' || true)" ]; then
        echo "Files besides Markdown differ from the commit checked out and would be built along with it; commit or move them first." >&2
        exit 1
    fi
    gradle_checks "$(git diff --name-only "$(git merge-base main HEAD)" HEAD)"
    echo "Verified $(git rev-parse --short HEAD); the branch can land."
    exit 0
fi
fast_checks
if [ -z "$(staged_code)" ]; then
    echo "Nothing staged for Gradle to check; commit away."
    exit 0
fi
# Gradle builds the working tree, so what it checked is the staged tree only while nothing else is there to build.
if ! git diff --quiet -- . ':(exclude)*.md' ||
    [ -n "$(git ls-files --others --exclude-standard | grep -vE '\.md$' || true)" ]; then
    echo "Unstaged or untracked files besides Markdown would be built along with the staged ones; stage or move them first." >&2
    git diff --name-only -- . ':(exclude)*.md' >&2
    git ls-files --others --exclude-standard | grep -vE '\.md$' >&2 || true
    exit 1
fi
tree=$(git write-tree)
gradle_checks "$(staged_code)"
mkdir -p "$(verified_trees)"
touch "$(verified_trees)/$tree"
echo "Verified; a plain git commit of these staged files now skips Gradle."
