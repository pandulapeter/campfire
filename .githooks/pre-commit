# The checks tests.yml runs that take seconds, run before every commit instead, so that nothing they refuse reaches
# the branch and waits there for a nightly run or a release to fail. Enabled once per clone with
# `git config core.hooksPath .githooks`.
set -e
. "$(dirname "$0")/lib.sh"
fast_checks
# Spotless and the unit tests need Gradle, so they run only when the commit stages more than Markdown. Gradle reruns only
# the modules a change reaches: a few seconds when none, under a minute for :presentation. The UI tests take minutes and
# stay in CI. Git holds the checkout's index lock for as long as this hook runs, so a tree .githooks/verify already
# checked is not built again: the lock is then held for seconds rather than for a build. Anything else is built here,
# reading the working tree, which is what the staged files are unless a commit stages part of a file.
if [ -n "$(staged_code)" ]; then
    tree=$(git write-tree)
    record="$(verified_trees)/$tree"
    if [ -e "$record" ]; then
        rm -f "$record"
    else
        gradle_queued spotlessCheck desktopTest --quiet
    fi
fi
