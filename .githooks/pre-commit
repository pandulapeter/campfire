# The checks tests.yml runs that take seconds, run before every commit instead, so that nothing they refuse reaches
# the branch and waits there for a nightly run or a release to fail. Enabled once per clone with
# `git config core.hooksPath .githooks`.
set -e
python3 .github/scripts/check_license_headers.py
python3 .github/scripts/check_sizes.py
python3 .github/scripts/check_layers.py
python3 .github/scripts/check_store_listings.py
python3 .github/scripts/store_listings.py --check
python3 .github/scripts/check_doc_names.py --staged
python3 .github/scripts/check_regexes.py
python3 .github/scripts/check_test_names.py
# The IDE drops the shared iOS run configuration now and then, and a commit staging everything has carried that deletion
# along several times.
if git diff --cached --name-only --diff-filter=D | grep -qx '.run/iOS.run.xml'; then
    echo "The commit deletes .run/iOS.run.xml; restore it with git restore --staged --worktree .run/iOS.run.xml." >&2
    exit 1
fi
# Spotless and the unit tests need Gradle, so they run only when the commit stages more than Markdown. Gradle reruns only
# the modules a change reaches: a few seconds when none, under a minute for :presentation. Both read the working tree,
# which is what the staged files are unless a commit stages part of a file. The UI tests take minutes and stay in CI.
if git diff --cached --name-only --diff-filter=ACMRD | grep -qvE '\.md$'; then
    ./gradlew spotlessCheck desktopTest --quiet
fi
