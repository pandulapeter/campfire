{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.github/scripts/check_sizes.py\" --hook",
            "statusMessage": "Checking file and function sizes"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 .github/scripts/check_sizes.py --shell-hook",
            "statusMessage": "Checking file and function sizes"
          }
        ]
      }
    ]
  }
}
