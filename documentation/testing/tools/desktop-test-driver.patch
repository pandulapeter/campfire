@@ -0,0 +1,44 @@
+package com.pandulapeter.campfire
+
+// TEMPORARY sync test driver - remove before committing anything.
+
+import com.pandulapeter.campfire.data.model.domain.SyncDeletionPolicy
+import com.pandulapeter.campfire.data.source.remote.api.model.AuthorizationCompletionPage
+import com.pandulapeter.campfire.presentation.ui.CampfireViewModel
+import java.io.File
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+object TestDriver {
+    private val dir = File(System.getProperty("user.home"), "driver").apply { mkdirs() }
+    private fun log(file: String, line: String) = File(dir, file).appendText("${System.currentTimeMillis()} $line\n")
+
+    suspend fun run(viewModel: CampfireViewModel) = coroutineScope {
+        launch { viewModel.syncState.collect { log("state.log", it.toString()) } }
+        val cmd = File(dir, "cmd")
+        while (true) {
+            val line = withContext(Dispatchers.IO) { if (cmd.exists()) cmd.readText().trim().also { cmd.delete() } else null }
+            if (!line.isNullOrBlank()) {
+                log("cmd.log", line)
+                val parts = line.split(" ", limit = 2)
+                val arg = parts.getOrNull(1).orEmpty()
+                runCatching {
+                    when (parts[0]) {
+                        "sync" -> viewModel.synchronizeLibrary(if (arg.isEmpty()) SyncDeletionPolicy.ASK else SyncDeletionPolicy.valueOf(arg))
+                        "stop" -> viewModel.cancelSynchronization()
+                        "save" -> viewModel.saveSongContent(arg, File(dir, "text").readText())
+                        "delete" -> viewModel.deleteSong(arg)
+                        "connect" -> viewModel.connectSyncProvider(viewModel.syncProviders.first(), AuthorizationCompletionPage("Campfire is connected", "You can close this tab."))
+                        "disconnect" -> viewModel.disconnectSyncProvider()
+                        else -> log("cmd.log", "UNKNOWN $line")
+                    }
+                }.onFailure { log("cmd.log", "FAILED $line: $it") }
+                log("cmd.log", "DONE $line")
+            }
+            delay(200)
+        }
+    }
+}
